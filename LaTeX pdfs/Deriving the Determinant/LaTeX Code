\begin{center}
    ------ which implies ------
    \vspace{3 mm}
\end{center}
$$
\boxed{\;p_A(A)=0\vphantom{\frac{a}{}}\;}\quad\implies\quad p_{[T]_\beta}([T]_\beta)=\left[p_{[T]_\beta}(T)\right]_\beta=[p_T(T)]_\beta=0\quad\implies\quad\boxed{\;p_T(T)=0\vphantom{\frac{a}{}}\;}

	\vspace{2 mm}
	\begin{center}
		$\varphi\circ\phi_{\varepsilon_x\varepsilon_y}^{\bm{C}}\phi_{\varepsilon_y}^{\bm{Y}}\phi_{\varepsilon_x}^{\bm{X}}=\left(1+(\varepsilon_x\varepsilon_yD_{\bm{C}}+\varepsilon_yD_{\bm{Y}}+\varepsilon_xD_{\bm{X}})+\frac{1}{2}\left(\varepsilon_y^2D^2_{\bm{Y}}+2\varepsilon_y\varepsilon_xD_{\bm{Y}}D_{\bm{X}}+\varepsilon_x^2D_{\bm{X}}^2\right)\right)\varphi+\varepsilon_x\varepsilon_y\mathcal{O}(\varepsilon_x,\varepsilon_y)$
		\vspace{4 mm}\\
		----- it follows from the previous section -----
		\vspace{4 mm}\\
		$\varphi\circ\phi_{\varepsilon_x\varepsilon_y}^{\bm{C}}\phi_{\varepsilon_y}^{\bm{Y}}\phi_{\varepsilon_x}^{\bm{X}}-\varphi\circ\phi_{\varepsilon_x}^{\bm{X}}\phi_{\varepsilon_y}^{\bm{Y}}=\varepsilon_x\varepsilon_y\left(D_{\bm{C}}-\left(D_{\bm{X}}D_{\bm{Y}}-D_{\bm{Y}}D_{\bm{X}}\right)\right)\varphi+\varepsilon_x\varepsilon_y\mathcal{O}(\varepsilon_x,\varepsilon_y)=0$
		\vspace{4 mm}\\
		----- this implies -----
		\vspace{4 mm}\\
		$\varepsilon_x\varepsilon_y\left(D_{\bm{C}}-[\bm{X},\bm{Y}]\right)\varphi=\varepsilon_x\varepsilon_y\mathcal{O}(\varepsilon_x,\varepsilon_y)\implies\left(D_{\bm{C}}-[\bm{X},\bm{Y}]\right)\varphi=\mathcal{O}(\varepsilon_x,\varepsilon_y)\implies \bm{C}=[\bm{X},\bm{Y}]+\mathcal{O}(\varepsilon_x,\varepsilon_y)$
	\end{center}
	\vspace{2 mm}  
	The implication of the above analysis is the observation that any such $\bm{C}$ must be locally (to first order) identical to the commutator $[\bm{X},\bm{Y}]$. In this sense, the commutator $[\bm{X},\bm{Y}]$ is the infinitesimal closure field. Furthermore, the corresponding (coordinate) closure discrepancy is of the following form:
	\vspace{1.5 mm}
	\begin{center}
		\large
		$\boxed{\;\varphi\circ\phi_{\varepsilon_x}^{\bm{X}}\phi_{\varepsilon_y}^{\bm{Y}}-\varphi\circ\phi_{\varepsilon_x\varepsilon_y}^{[\bm{X},\bm{Y}]}\phi_{\varepsilon_y}^{\bm{Y}}\phi_{\varepsilon_x}^{\bm{X}}=\varepsilon_x\varepsilon_y\mathcal{O}(\varepsilon_x,\varepsilon_y)\;}$
	\end{center}
	
	
	\section*{Properties of the Commutator}
	Let $\bm{X},\bm{Y},\bm{Z}\in\Gamma(TM)$, and let $f\in C^{\infty}(M,\mathbb{R})$. Also, consider the scalars $a,b\in\mathbb{R}$. Without explicit proof, the following properties hold point-wise, but can be easily checked.
	\vspace{2 mm}
	\begin{itemize}
		\item $[a\bm{X}+b\bm{Y},\bm{Z}]=a[\bm{X},\bm{Z}]+b[\bm{Y},\bm{Z}]$\, ----------------------------------- Bilinearity in First Slot --------------------
		\item $[\bm{X},a\bm{Y+}b\bm{Z}]=a[\bm{X},\bm{Y}]+b[\bm{X},\bm{Z}]$ ----------------------------------- Bilinearity in Second Slot -----------------
		\item $[\bm{X},\bm{Y}]=-[\bm{Y,\bm{X}}]$\,\, --------------------------------------------------------- Antisymmetric ------------------------------
		\item $[\bm{X},f\,\bm{Y}]=f\left[\bm{X},\bm{Y}\right]+\bm{X}[f]\,\bm{Y}$ ------------------------------------------ Derivation in Second Slot -----------------
		\item $[f\,\bm{X},\bm{Y}]=f\left[\bm{X},\bm{Y}\right]-\bm{Y}[f]\,\bm{X}$ ------------------------------------------ Derivation in First Slot --------------------
		\item $[\bm{X},[\bm{Y},\bm{Z}]]+[\bm{Y},[\bm{Z},\bm{X}]]+[\bm{Z},[\bm{X},\bm{Y}]]=0$\,\, --------------------------- Jacobi Identity ------------------------------
	\end{itemize}
	\vspace{2 mm}
	Observe that $[\bm{X},\cdot\,]$ behaves as a derivation on $\Gamma(TM)$. That is to say, if $\mathscr{D}_{\bm{X}}(\cdot)=[\bm{X},\cdot\,]$, then it obeys the Leibniz rule $\mathscr{D}_{\bm{X}}(f\,\bm{Y})=f\mathscr{D}_{\bm{X}}\bm{Y}+\bm{X}[f]\,\bm{Y}$. Note $\mathscr{D}$ cannot be a linear connection. Upon further investigation, one can identify the pairing $(\Gamma(TM),[\cdot,\cdot])$ as a Lie algebra (hence the Jacobi identity).  
	
	\section*{The Pullback and Pushforward}

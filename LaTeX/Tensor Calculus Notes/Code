	In the above figure, the vector field $\bm{Y}$ was Lie dragged from $\phi_t^{\bm{X}}(p)$ back to $p$ along the vector field $\bm{X}$ (flow) via the map $(\phi_{-t}^{\bm{X}})_*$, thus enabling $\bm{Y}(\phi_t^{\bm{X}}(p))$ to be compared to $\bm{Y}(p)$. If not clear, this can only be done due to $\phi_t^{\bm{X}}$ being a diffeomorphism on $M$ (i.e. $\phi_{-t}^{\bm{X}}\circ\phi_t^{\bm{X}}=\mathrm{id}_M$). This is especially evident in coordinates:
	\vspace{2 mm}
	\begin{center}
		$\left(\phi_{-t}^{\bm{X}}\right)_*\left(\bm{Y}\left(\phi_t^{\bm{X}}(p)\right)\right)=\bm{Y}\left(\phi_t^{\bm{X}}(p)\right)\left[x^i\circ\phi_{-t}^{\bm{X}}\right]\bm{e}_i\left(\phi_{-t}^{\bm{X}}\circ\phi_t^{\bm{X}}(p)\right)=\bm{Y}\left(\phi_t^{\bm{X}}(p)\right)\left[x^i\circ\phi_{-t}^{\bm{X}}\right]\bm{e}_i(p)\in T_pM$
	\end{center}
	\vspace{2 mm}
	Using Lie drag, a new derivative operation on $\Gamma(TM)\times\Gamma(TM)$ referred to as the Lie derivative denoted by $\mathcal{L}$, although not a linear connection, can be constructed, and is contextually defined as such:
	\vspace{0.5 mm}
	\begin{center}
		$\mathcal{L}_{\bm{X}}\bm{Y}(p)\coloneq\left.\dfrac{d}{dt}\right|_{t=0}\left(\phi_{-t}^{\bm{X}}\right)_*\left(\bm{Y}\left(\phi_t^{\bm{X}}(p)\right)\right)=\lim\limits_{\delta t\to0}\dfrac{\left(\phi_{-\delta t}^{\bm{X}}\right)_*\left(\bm{Y}\left(\phi_{\delta t}^{\bm{X}}(p)\right)\right)-\bm{Y}(p)}{\delta t}$
	\end{center}
	\vspace{0.5 mm}
	To make this definition more manageable, an auxiliary function $f\in C^{\infty}(M,\mathbb{R})$ will be introduced. That way $\mathcal{L}_{\bm{X}}\bm{Y}(p)$ can act as a directional derivative operator, which can operate on $f$ as follows:
	\vspace{1 mm}
	\begin{align*}
		\mathcal{L}_{\bm{X}}\bm{Y}(p)\left[f\right]&=\lim\limits_{\delta t\to0}\dfrac{\left(\phi_{-\delta t}^{\bm{X}}\right)_*\left(\bm{Y}\left(\phi_{\delta t}^{\bm{X}}(p)\right)\right)\left[f\right]-\bm{Y}(p)\left[f\right]}{\delta t}=\lim\limits_{\delta t\to0}\dfrac{\bm{Y}\left(\phi_{\delta t}^{\bm{X}}(p)\right)\left[f\left(\phi_{-\delta t}^{\bm{X}}\right)\right]-\bm{Y}(p)\left[f\right]}{\delta t}
		\\[4 mm]
		&=\lim\limits_{\delta t\to0}\dfrac{\bm{Y}\left(\phi_{\delta t}^{\bm{X}}(p)\right)\left[f\left(\phi_{-\delta t}^{\bm{X}}\right)\right]-\bm{Y}\left(\phi_{\delta t}^{\bm{X}}(p)\right)\left[f\right]}{\delta t}+\lim\limits_{\delta t\to0}\dfrac{\bm{Y}\left(\phi_{\delta t}^{\bm{X}}(p)\right)\left[f\right]-\bm{Y}(p)[f]}{\delta t}
		\\[3 mm]
		&=\lim\limits_{\delta t\to0}\bm{Y}\left(\phi_{\delta t}^{\bm{X}}(p)\right)\left[\dfrac{f\left(\phi_{-\delta t}^{\bm{X}}\right)-f}{\delta t}\right]+\lim\limits_{\delta t\to0}\dfrac{\bm{Y}[f]\left(\phi_{\delta t}^{\bm{X}}(p)\right)-\bm{Y}[f]\left(p\right)}{\delta t}
		\\[3 mm]
		&=\bm{Y}\left(\phi_0^{\bm{X}}(p)\right)\left[\lim\limits_{\delta t\to0}\dfrac{f\left(\phi_{-\delta t}^{\bm{X}}\right)-f}{\delta t}\right]+\bm{X}(p)\left[\bm{Y}[f]\right]\qquad\text{(directional differentiation)}
		\\[4 mm]
		&=\bm{Y}(p)\left[-\bm{X}[f]\right]+\bm{X}(p)\left[\bm{Y}[f]\right]=\bm{X}\left[\bm{Y}[f]\right](p)-\bm{Y}\left[\bm{X}[f]\right](p)=[\bm{X},\bm{Y}][f]\left(p\right)
	\end{align*}
	\begin{center}
		\vspace{1 mm}
		\begin{Large}
			$\boxed{\;\mathcal{L}_{\bm{X}}\bm{Y}=[\bm{X},\bm{Y}]\;}$
		\end{Large}
		\vspace{3 mm}\\
		(The Lie derivative on $\Gamma(TM)\times\Gamma(TM)$ is identical to the commutator, inheriting all of its properties.)
	\end{center}
	
	\section*{Pulling Back Lie Drag}
	In pursuit of extending the Lie derivative $\mathcal{L}$ into being applicable to $\Gamma(T^*M)$ and $C^{\infty}(M,\mathbb{R})$, the notion of Lie drag will be extended into the domain of $T^*M$ using the induced pullback on the flows of vector fields.
	\vspace{3 mm}\\
	In particular, provided that $\omega\in\Gamma(T^*M)$, $\bm{X}\in\Gamma(TM)$, and $f\in C^{\infty}(M,\mathbb{R})$, consider how $f$ or $\omega$ changes along the flow of $\bm{X}$. That is, in order to compare $f$ or $\omega_{\phi_t^{\bm{X}}(p)}$ relative to $\omega_p$, pull the scalar field or covector back to $p$ along the flow of $\bm{X}$ using its pullback $(\phi_t^{\bm{X}})^*$ defined in each case. Starting with scalar fields: 
	\vspace{2 mm}
	\begin{center}
		$\mathcal{L}_{\bm{X}}f(p)\coloneq\left.\dfrac{d}{dt}\right|_{t=0}\left(\phi_t^{\bm{X}}\right)^*f(p)=\left.\dfrac{d}{dt}\right|_{t=0}f\left(\phi_t^{\bm{X}}(p)\right)=\bm{X}[f]\left(p\right)\implies\boxed{\;\mathcal{L}_{\bm{X}}f=\bm{X}[f]\;}$
		\vspace{4 mm}\\
		----- moving on to covector fields -----
		\vspace{4 mm}\\
		$\mathcal{L}_{\bm{X}}\,\omega\,(\bm{v}_p)\coloneq\left.\dfrac{d}{dt}\right|_{t=0}\left(\phi_t^{\bm{X}}\right)^*\omega_{\phi_t^{\bm{X}}(p)}(\bm{v}_p)=\left.\dfrac{d}{dt}\right|_{t=0}\omega_{\phi_t^{\bm{X}}(p)}\left(\left(\phi_t^{\bm{X}}\right)_*(\bm{v}_p)\right)=\lim\limits_{\delta t\to0}\dfrac{\omega_{\phi_{\delta t}^{\bm{X}}(p)}\left(\left(\phi_{\delta t}^{\bm{X}}\right)_*(\bm{v}_p)\right)-\omega_p(\bm{v}_p)}{\delta t}$
	\end{center}
	\vspace{1.75 mm}
	To make this definition more manageable, an auxiliary vector field $\bm{V}\in\Gamma(TM)$ will be introduced instead of $\bm{v}_p\in T_pM$. That way the properties of the directional derivative could be taken advantage of as follows:
	\begin{align*}
		\mathcal{L}_{\bm{X}}\,\omega\,(\bm{V}(p))&=\lim\limits_{\delta t\to0}\dfrac{\omega_{\phi_{\delta t}^{\bm{X}}(p)}\left(\left(\phi_{\delta t}^{\bm{X}}\right)_*(\bm{V}(p))\right)-\omega_p(\bm{V}(p))}{\delta t}
		\\[4 mm]
		&=\lim\limits_{\delta t\to0}\dfrac{\omega_{\phi_{\delta t}^{\bm{X}}(p)}\left(\left(\phi_{\delta t}^{\bm{X}}\right)_*(\bm{V}(p))\right)-\omega_{\phi_{\delta t}^{\bm{X}}(p)}\left(\bm{V}\left(\phi_{\delta t}^{\bm{X}}(p)\right)\right)}{\delta t}+\lim\limits_{\delta t\to0}\dfrac{\omega_{\phi_{\delta t}^{\bm{X}}(p)}\left(\bm{V}\left(\phi_{\delta t}^{\bm{X}}(p)\right)\right)-\omega_p(\bm{V}(p))}{\delta t}
		\\[4 mm]
		&=\lim\limits_{\delta t\to0}\omega_{\phi_{\delta t}^{\bm{X}}(p)}\left(\dfrac{\left(\phi_{\delta t}^{\bm{X}}\right)_*(\bm{V}(p))-\bm{V}\left(\phi_{\delta t}^{\bm{X}}(p)\right)}{\delta t}\right)+\lim\limits_{\delta t\to0}\dfrac{\omega(\bm{V})\left(\phi_{\delta t}^{\bm{X}}(p)\right)-\omega(\bm{V})\left(p\right)}{\delta t}
		\\[4 mm]
		&=\lim\limits_{\delta t\to0}\omega_{\phi_{\delta t}^{\bm{X}}(p)}\left.\left(\dfrac{\left(\phi_{\delta t}^{\bm{X}}\right)_*\left(\bm{V}\left(\phi_{-\delta t}^{\bm{X}}\right)\right)-\bm{V}}{\delta t}\right)\right|_{\phi_{\delta t}^{\bm{X}}(p)}+\bm{X}(p)\left[\omega(\bm{V})\right]
		\\[4 mm]
		&=\omega_{\phi_0^{\bm{X}}(p)}\left.\left(\lim\limits_{\delta t\to0}\dfrac{\left(\phi_{\delta t}^{\bm{X}}\right)_*\left(\bm{V}\left(\phi_{-\delta t}^{\bm{X}}\right)\right)-\bm{V}}{\delta t}\right)\right|_{\lim\limits_{\delta t\to0}\phi_{\delta t}^{\bm{X}}(p)}+\bm{X}[\omega(\bm{V})]\left(p\right)
		\\[4 mm]
		&=\omega_p\left(\lim\limits_{\delta t\to0}\dfrac{\left(\phi_{\delta t}^{\bm{X}}\right)_*\left(\bm{V}\left(\phi_{-\delta t}^{\bm{X}}(p)\right)\right)-\bm{V}(p)}{\delta t}\right)+\bm{X}[\omega(\bm{V})]\left(p\right)
		\\[4 mm]
		&=\omega_p(-\mathcal{L}_{\bm{X}}\bm{V}(p))+\bm{X}[\omega(\bm{V})]\left(p\right)=\bm{X}[\omega(\bm{V})]\left(p\right)-\omega(\mathcal{L}_{\bm{X}}\bm{V})\left(p\right)=\bm{X}[\omega(\bm{V})]\left(p\right)-\omega([\bm{X},\bm{V}])\left(p\right)
	\end{align*}
	\begin{center}
		\vspace{1.75 mm}
		\begin{Large}
			$\boxed{\;\mathcal{L}_{\bm{X}}\,\omega\,(\bm{V})=\bm{X}[\omega(\bm{V})]-\omega([\bm{X},\bm{V}])\;}$
		\end{Large}
		\begin{large}
			\vspace{1.75 mm}\\
			The Lie Derivative on Covector Fields\phantom{00}
		\end{large}
	\end{center}
	\vspace{1 mm}
	As expected, the above formula does not depend on the derivatives of $\bm{V}$. This is especially clear via a local coordinate expansion. In fact, upon simplifying $\mathcal{L}_{\bm{X}}\,\omega\,(\bm{V})=X^i\partial_i(\omega_jV^j)-\omega((X^i\partial_iV^j-V^i\partial_iX^j)\,\bm{e}_j)$, without explicit demonstration, one arrives at $(X^i\partial_i\,\omega_j+\partial_jX^i\omega_i)V^j$, which can be summarized as follows:
	\vspace{1.25 mm}
	\begin{center}
		\begin{Large}
			$\boxed{\;\mathcal{L}_{\bm{X}}\,\omega=\left(X^i\partial_i\,\omega_j+\partial_jX^i\omega_i\right)\bm{e}^j\;}$
		\end{Large}
		\vspace{2 mm}\\
		\large
		Local Coordinate Expansion of the Lie Derivative on Covector Fields\phantom{00}
	\end{center}
	
	
	
	\section*{What is a Tensor?}
	By definition, a type $(r,s)$ tensor at $p\in M$ is a multi-linear map $T_p: (T_p^*M)^r\times(T_pM)^s\to\mathbb{R}$, where $\otimes^{r,s}T_pM$ is the space of all such operations at $p\in M$. Specifically, provided that $T_{\mu_1\cdots\mu_s}^{\nu_1\cdots\nu_r}\in C^{\infty}(M,\mathbb{R})$, upon specifying a coordinate frame $\left\{\bm{e}_i\right\}$ and a co-coordinate frame $\left\{\bm{e}^i\right\}$, one can write: 
	\begin{center}
		\large
		$T_p:\left(\theta^1,\cdots,\theta^r;\bm{v}_1,\cdots,\bm{v}_s\right)\in\left(T^*_pM\right)^r\times\left(T_pM\right)^s\mapsto T_{\mu_1\cdots\mu_s}^{\nu_1\cdots\nu_r}(p)\prod\limits_{j=1}^r\theta^j(\bm{e}_{\nu_j}(p))\prod\limits_{i=1}^s\bm{e}^{\mu_i}_p(\bm{v}_i)$ 
	\end{center}
	The object $T_{\mu_1\cdots\mu_s}^{\nu_1\cdots\nu_r}\in C^{\infty}(M,\mathbb{R})$ is the $\nu_1\cdots\nu_r$ contravariant, $\mu_1\cdots\mu_s$ covariant component of the tensor field. Moreover, provided that $\bm{\pi}^{(r,s)}:T_p\in\otimes^{r,s}T_pM\mapsto p$, the collection of smooth tensor fields over $M$ can be fashioned as $\Gamma(\otimes^{r,s} TM)\coloneq\left\{T:M\times(T^*M)^r\times(TM)^s\to\mathbb{R}\,|\,\bm\pi^{(r,s)}\circ T=\mathrm{id}_M, T\;\text{smooth}\right\}$. 
	\vspace{3 mm}\\
	Via point-wise addition, $\otimes^{r,s}T_pM$
	and $\Gamma(\otimes^{r,s}TM)$ can be interpreted as vector spaces over $\mathbb{R}$ and $C^{\infty}(M,\mathbb{R})$ respectively. That is, for any $f,g\in C^{\infty}(M,\mathbb{R})$, if $T,S\in\Gamma(\otimes^{r,s}TM)$, then $fT+gS\in\Gamma(\otimes^{r,s}TM)$, where:
	\vspace{2 mm}
	\begin{center}
		\large
		$(fT+gS)_p:\vartheta\in\left(T^*_pM\right)^r\times\left(T_pM\right)^s\mapsto f(p)T_p(\vartheta)+g(p)S_p(\vartheta)$
		\vspace{4 mm}\\
		----- and -----
		\vspace{4 mm}\\
		$(fT+gS)_{\mu_1\cdots\mu_s}^{\nu_1\cdots\nu_r}=fT_{\mu_1\cdots\mu_s}^{\nu_1\cdots\nu_r}+gS_{\mu_1\cdots\mu_s}^{\nu_1\cdots\nu_r}$
	\end{center}
	\vspace{2 mm}
	As a side note,  $\forall\,\bm{V}\in\Gamma(TM)$, let $\bm{V}:\omega\in\Gamma(T^*M)\mapsto\omega(\bm{V})$. Now, via the tensor product $\otimes$, any two tensor fields $A\in\Gamma(\otimes^{r,s}TM)$ and $B\in\Gamma(\otimes^{t,u}TM)$ can be multiplied to produce another (i.e. $A\otimes B$) given as such:
	\begin{center}
		\large
		$(A\otimes B)_p:(\theta^1,\cdots,\theta^{r+t};\bm{v}_1,\cdots,\bm{v}_{s+u})\mapsto
		A_{\mu_1\cdots\mu_s}^{\nu_1\cdots\nu_r}(p)\,
		B_{\mu_{s+1}\cdots\mu_{s+u}}^{\nu_{r+1}\cdots\nu_{r+t}}(p)\prod\limits_{j=1}^{r+t}\theta^j\left(\bm{e}_{\nu_j}(p)\right)\prod\limits_{i=1}^{s+u}\bm{e}_p^{\mu_i}(\bm{v}_i)$
		\vspace{2mm}\\
		----- and -----
		\vspace{4mm}\\
		$(A\otimes B)_{\mu_1\cdots\mu_{s+u}}^{\nu_1\cdots\nu_{r+t}}
		=
		A_{\mu_1\cdots\mu_s}^{\nu_1\cdots\nu_r}
		B_{\mu_{s+1}\cdots\mu_{s+u}}^{\nu_{r+1}\cdots\nu_{r+t}}$
	\end{center}
	\vspace{2 mm}
	Upon observing $T_{\mu_1\cdots\mu_s}^{\nu_1\cdots\nu_r}=T(\bm{e}^{\nu_1},\cdots,\bm{e}^{\nu_r};\bm{e}_{\mu_1},\cdots,\bm{e}_{\mu_s})$ point-wise, any type $(r,s)$ tensor field $T$ can be expanded over the tensor product over the coordinate basis $\left\{\bm{e}_{\nu_1}\otimes\cdots\otimes\bm{e}_{\nu_r}\otimes\bm{e}^{\mu_1}\otimes\cdots\otimes\bm{e}^{\mu_s}\right\}$ as such: 
	\vspace{2 mm}
	\begin{center}
		\large
		$T=T_{\mu_1\cdots\mu_s}^{\nu_1\cdots\nu_r}\,\bm{e}_{\nu_1}\otimes\cdots\otimes\bm{e}_{\nu_r}\otimes\bm{e}^{\mu_1}\otimes\cdots\otimes\bm{e}^{\mu_s}$
	\end{center}
	\vspace{2 mm}
	Because under the coordinate transformation $x\to\ibar{x}$ the (coordinate) basis elements transform via the Jacobian as $\bm{e}_i=\frac{\partial\bar{x}^j}{\partial x^i}\bbar{\bm{e}}_j$ and $\bm{e}^k=\frac{\partial x^k}{\partial \bar{x}^j}\bbar{\bm{e}}^j$ (see Appendix A), under the same coordinate transformation:
	\vspace{2 mm}
	\begin{center}
		\begin{large}
			$\boxed{\;\bbar{T}_{\alpha_1\cdots\alpha_s}^{\beta_1\cdots\beta_r}=\dfrac{\partial x^{\mu_1}}{\partial\bar{x}^{\alpha_1}}\cdots\dfrac{\partial x^{\mu_s}}{\partial\bar{x}^{\alpha_s}}\dfrac{\partial\bar{x}^{\beta_1}}{\partial x^{\nu_1}}\cdots\dfrac{\partial\bar{x}^{\beta_r}}{\partial x^{\nu_r}}\,T_{\mu_1\cdots\mu_s}^{\nu_1\cdots\nu_r}\;}$
			\vspace{2 mm}\\
			Tensor Component Transformation Law
		\end{large}
	\end{center}
	\vspace{2 mm}
	This transformation law ensures that the tensor field $T$ remains coordinate invariant. If the components do not transform this way, the field is non-tensorial. The proof of the transformation law is given below: 
	\vspace{2 mm}
	\begin{align*}
		T&=T_{\mu_1\cdots\mu_s}^{\nu_1\cdots\nu_r}\left(\dfrac{\partial\bar{x}^{\beta_1}}{\partial x^{\nu_1}}\,\bbar{\bm{e}}_{\beta_1}\right)\otimes\cdots\otimes\left(\dfrac{\partial\bar{x}^{\beta_r}}{\partial x^{\nu_r}}\,\bbar{\bm{e}}_{\beta_r}\right)\otimes\left(\dfrac{\partial x^{\mu_1}}{\partial\bar{x}^{\alpha_1}}\,\bbar{\bm{e}}^{\alpha_1}\right)\otimes\cdots\otimes\left(\dfrac{\partial x^{\mu_s}}{\partial\bar{x}^{\alpha_s}}\,\bbar{\bm{e}}^{\alpha_s}\right)
		\\[4 mm]
		&=\dfrac{\partial x^{\mu_1}}{\partial\bar{x}^{\alpha_1}}\cdots\dfrac{\partial x^{\mu_s}}{\partial\bar{x}^{\alpha_s}}\dfrac{\partial\bar{x}^{\beta_1}}{\partial x^{\nu_1}}\cdots\dfrac{\partial\bar{x}^{\beta_r}}{\partial x^{\nu_r}}\,T_{\mu_1\cdots\mu_s}^{\nu_1\cdots\nu_r}\,\bbar{\bm{e}}_{\beta_1}\otimes\cdots\otimes\bbar{\bm{e}}_{\beta_r}\otimes\bbar{\bm{e}}^{\alpha_1}\otimes\cdots\otimes\bbar{\bm{e}}^{\alpha_s}
		\\[4 mm]
		&=\bbar{T}_{\alpha_1\cdots\alpha_s}^{\beta_1\cdots\beta_r}\,\bbar{\bm{e}}_{\beta_1}\otimes\cdots\otimes\bbar{\bm{e}}_{\beta_r}\otimes\bbar{\bm{e}}^{\alpha_1}\otimes\cdots\otimes\bbar{\bm{e}}^{\alpha_s}\quad\square\quad\text{(due to linear independence)}
	\end{align*}
	
	\section*{Properties of Tensor Fields ()}
	Let $T,S\in\Gamma(\otimes^{r,s}TM)$, and let $f\in C^{\infty}(M,\mathbb{R})$. Also, consider the scalars $a,b\in\mathbb{R}$. Without explicit proof, the following properties hold point-wise, but can be easily checked.
	\vspace{2 mm}
	\begin{itemize}
		\item $T(\cdots,a\omega,\cdots;\cdots,\bm{X},\cdots)=T(\cdots,\omega,\cdots;\cdots,a\bm{X},\cdots)=aT(\cdots,\omega,\cdots;\cdots,\bm{X},\cdots)$ -----------------
		\item $T(\cdots,\alpha+\beta,\cdots;\cdots)=T(\cdots,\alpha,\cdots;\cdots)+T(\cdots,\beta,\cdots;\cdots)$ -------------
		\item $T(\cdots;\cdots,\bm{X}+\bm{Y},\cdots)=T(\cdots;\cdots,\bm{X},\cdots)+T(\cdots;\cdots,\bm{Y},\cdots)$ -------------------------
		\item $T_{\mu_1\cdots\mu_s}^{\nu_1\cdots\nu_r}=0\iff\bbar{T}_{\alpha_1\cdots\alpha_s}^{\beta_1\cdots\beta_r}=0$ ----------------------------------
	\end{itemize}
	
	\pagebreak
	
	\section*{Tensor Contraction}
	Given a type $(r,s)$ tensor field $T$, provided that $r,s\geq1$, tensor contraction is a linear operation with the property that $C:T\in\Gamma(\otimes^{r,s}TM)\mapsto C(T)\in\Gamma(\otimes^{r-1,s-1}TM)$. To be specific, on a point-wise basis, the operation contracts a pair of contravariant and covariant slots as follows:
	\begin{center}
		\vspace{2 mm}
		\large
		$C_i^j(T)\coloneq T_{\mu_1\cdots\mu_{i-1}\lambda\,\mu_{i+1}\cdots\mu_s}^{\nu_1\cdots\nu_{j-1}\lambda\,\nu_{j+1}\cdots\nu_r}\,\bm{e}_{\nu_1}\otimes\cdots\otimes\bm{e}_{\nu_{j-1}}\otimes\bm{e}_{\nu_{j+1}}\otimes\cdots\otimes\bm{e}_{\nu_r}\otimes\bm{e}^{\mu_1}\otimes\cdots\otimes\bm{e}^{\mu_{i-1}}\otimes\bm{e}^{\mu_{i+1}}\otimes\cdots\otimes\bm{e}^{\mu_s}$
	\end{center}
	\vspace{2 mm}
	Although not immediately obvious, upon invoking a coordinate transformation on each term in the above definition, contraction can be demonstrated to be an intrinsic operation (i.e. coordinate independent). 
	
	\section*{Tensorial Analysis on Covariant Differentiation}
	The covariant derivative of the vector field $\bm{V}$ is defined by $\nabla\bm{V}\coloneq\left(\nabla_j\bm{V}\right)^k\bm{e}_k\otimes\,\bm{e}^j$. This implies that, for any $\bm{u}\in\Gamma(TM)$ and $\omega\in\Gamma(T^*M)$, one has $\nabla\bm{V}(\omega\,;\bm{u})=\omega(\nabla_{\bm{u}}\bm{V})$, or equivalently, $\nabla\bm{V}(\bm{u})=\nabla_{\bm{u}}\bm{V}$. From this perspective, one can write $\left(\nabla_j\bm{V}\right)^k=\left(\nabla\bm{V}\right)_j^k$, where $\nabla\bm{V}$ is a type $(1,1)$ tensor field.
	\vspace{3 mm}\\
	One significant takeaway from this is that despite $\left(\nabla_j\bm{V}\right)^k=\partial_jV^k+\Gamma_{ij}^kV^i$ being a tensor field component, its constituents are not. To be specific, neither $\partial_jV^k$ nor $\Gamma_{ij}^k$ could be the component of a tensor field due to their (non-tensorial) coordinate dependencies. With the understanding that $\bbar{\nabla}_{\nu}=\nabla_{\bbar{\bm{e}}_{\nu}}$, the transformation law for the connection coefficients will be derived as such: 
	\vspace{2 mm}
	\begin{center}
		$\Gamma_{ij}^k\,\bm{e}_k=\nabla_j\,\bm{e}_i=\dfrac{\partial\ibar{x}^\nu}{\partial x^j}\bbar{\nabla}_\nu\left(\dfrac{\partial\ibar{x}^\mu}{\partial x^i}\bbar{\bm{e}}_\mu\right)=\dfrac{\partial\ibar{x}^\nu}{\partial x^j}\left(\dfrac{\partial}{\partial\ibar{x}^\nu}\dfrac{\partial\ibar{x}^\lambda}{\partial x^i}+\bbar{\Gamma}_{\mu\nu}^\lambda\dfrac{\partial\ibar{x}^\mu}{\partial x^i}\right)\bbar{\bm{e}}_\lambda$
		\vspace{4 mm}\\
		$=\dfrac{\partial\ibar{x}^\nu}{\partial x^j}\left(\dfrac{\partial x^\sigma}{\partial\ibar{x}^\nu}\dfrac{\partial}{\partial x^\sigma}\dfrac{\partial\ibar{x}^\lambda}{\partial x^i}+\bbar{\Gamma}_{\mu\nu}^\lambda\dfrac{\partial\ibar{x}^\mu}{\partial x^i}\right)\dfrac{\partial x^k}{\partial\ibar{x}^\lambda}\bm{e}_k=\left(\dfrac{\partial\ibar{x}^\nu}{\partial x^j}\dfrac{\partial x^\sigma}{\partial\ibar{ x}^\nu}\dfrac{\partial^2\ibar{x}^\lambda}{\partial x^\sigma\partial x ^i}\dfrac{\partial x^k}{\partial\ibar{x}^\lambda}+\dfrac{\partial\ibar{x}^\nu}{\partial x^j}\bbar{\Gamma}_{\mu\nu}^\lambda\dfrac{\partial\ibar{x}^\mu}{\partial x^i}\dfrac{\partial x^k}{\partial\ibar{x}^\lambda}\right)\bm{e}_k$
		\vspace{4 mm}\\
		$=\left(\delta^\sigma_j\dfrac{\partial^2\ibar{x}^\lambda}{\partial x^\sigma\partial x^i}\dfrac{\partial x^k}{\partial\ibar{x}^\lambda}+\dfrac{\partial\ibar{x}^\nu}{\partial x^j}\bbar{\Gamma}_{\mu\nu}^\lambda\dfrac{\partial\ibar{x}^\mu}{\partial x^i}\dfrac{\partial x^k}{\partial\ibar{x}^\lambda}\right)\bm{e}_k=\left(\dfrac{\partial\ibar{x}^\mu}{\partial x^i}\dfrac{\partial\ibar{x}^\nu}{\partial x^j}\dfrac{\partial x^k}{\partial\ibar{x}^\lambda}\bbar{\Gamma}_{\mu\nu}^\lambda+\dfrac{\partial^2\ibar{x}^\lambda}{\partial x^i\partial x^j}\dfrac{\partial x^k}{\partial\ibar{x}^\lambda}\right)\bm{e}_k$
		\vspace{4 mm}\\
		----- which implies due to linear independence -----
		\vspace{4 mm}\\
		\begin{large}
			$\boxed{\;\Gamma_{ij}^k=\dfrac{\partial\ibar{x}^\mu}{\partial x^i}\dfrac{\partial\ibar{x}^\nu}{\partial x^j}\dfrac{\partial x^k}{\partial\ibar{x}^\lambda}\bbar{\Gamma}_{\mu\nu}^\lambda+\dfrac{\partial^2\ibar{x}^\lambda}{\partial x^i\partial x^j}\dfrac{\partial x^k}{\partial\ibar{x}^\lambda}\;}$
			\vspace{3 mm}\\
			Transformation Law of the Connection Coefficients 
		\end{large}
	\end{center}
	\vspace{2 mm}
	By inspection, $\Gamma_{ij}^k$ does not transform as a type $(1,2)$ tensor field component due to the presence of the second order coordinate dependency. Likewise, in the appropriate context, the transformation law for $\partial_jV^k$ will be derived as such with the expectation that it is non-tensorial:
	\vspace{2 mm}
	\begin{center}
		$\dfrac{\partial V^k}{\partial x^j}=\dfrac{\partial\bar{x}^\mu}{\partial x^j}\dfrac{\partial}{\partial\bar{x}^\mu}\left(\dfrac{\partial x^k}{\partial\bar{x}^\nu}\,\bbar{V}^\nu\right)=\dfrac{\partial\bar{x}^{\mu}}{\partial x^j}\left(\dfrac{\partial^2x^k}{\partial\bar{x}^{\mu}\partial\bar{x}^\nu}\bbar{V}^\nu+\dfrac{\partial x^k}{\partial\bar{x}^\nu}\dfrac{\partial\bbar{V}^{\nu}}{\partial\bar{x}^{\mu}}\right)=\dfrac{\partial\bar{x}^\mu}{\partial x^j}\dfrac{\partial x^k}{\partial\bar{x}^\nu}\dfrac{\partial\bbar{V}^{\nu}}{\partial\bar{x}^{\mu}}+\dfrac{\partial\bar{x}^\mu}{\partial x^j}\dfrac{\partial^2x^k}{\partial\bar{x}^{\mu}\partial\bar{x}^\nu}\bbar{V}^\nu$
	\end{center}
	\vspace{2 mm}
	It is this reason as to why the naive operation $\bm{V}\mapsto\bm{u}\left[\bm{e}^k(\bm{V})\right]\bm{e}_k=u^j\partial_jV^k\bm{e}_k$ fails to measure intrinsic change over a manifold. The connection coefficients adjust the operation by eliminating its second order coordinate dependencies, thereby producing a coordinate invariant operation (covariant differentiation).
	\vspace{3 mm}\\
	As a side note, if there exists a coordinate system $\bar{x}^i$ and curve mapping $\gamma$ such that $\bbar{\Gamma}_{\mu\nu}^{\lambda}(\gamma)=0$, then in any coordinate system $x^i$, it strictly follows from the transformation law for connection coefficient  that $\Gamma_{ij}^k=\frac{\partial^2\ibar{x}^\lambda}{\partial x^i\partial x^j}\frac{\partial x^k}{\partial\ibar{x}^\lambda}$ when restricted to (the range of) the curve mapping $\gamma$ over its domain.
	

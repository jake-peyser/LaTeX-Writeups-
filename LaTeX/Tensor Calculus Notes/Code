	\section*{Covariant Divergence}
	In light of the fact that $\nabla\bm{V}$ is a tensor field, the notion of divergence can be generalized by contracting the covariant derivative into a scalar field via the trace operation. In particular, define the covariant divergence of $\bm{V}$ by $\mathrm{div}(\bm{V})\coloneq\mathrm{tr}(\nabla\bm{V})=C_1^1(\nabla\bm{V})=\left(\nabla\bm{V}\right)_i^i=\left(\nabla_i\bm{V}\right)^i=\partial_iV^i+\Gamma_{ij}^jV^i$. Unlike the conventional divergence $\partial_iV^i$, because $\mathrm{div}(\bm{V})$ is a scalar field derived from contraction, no matter the coordinate system, for any fixed input in $M$, its output ($\mathbb{R}$) will always return the same value. The demonstration is as follows:
	\begin{center}
		$\mathrm{div}(\bm{V})=\left(\nabla\bm{V}\right)_i^i=\dfrac{\partial\bar{x}^j}{\partial x^i}\dfrac{\partial x^i}{\partial\bar{x}^k}\,\bbar{\left(\nabla\bm{V}\right)}_j^k=\delta_k^j\,\bbar{\left(\nabla\bm{V}\right)}_j^k=\bbar{\left(\nabla\bm{V}\right)}_j^j\quad\square$
	\end{center}
	
	
	\section*{The Metric Tensor - Sketch}
	The metric tensor $g$ is a symmetric nondegenerate bilinear form on $TM$. In particular, there exist components $g_{\mu\nu}:M\to\mathbb{R}$ such that $g=g_{\mu\nu}\,\bm{e}^\mu\otimes\,\bm{e}^\nu$, where $g_{\mu\nu}=g_{\nu\mu}$. Given vector fields $\bm{X}$ and $\bm{Y}$, $g(\bm{X},\bm{Y})=g_{\mu\nu}X^\mu Y^\nu$, and so by definition, if $g(\bm{X},\bm{Y})=0$ for every vector field $\bm{X}$, then $\bm{Y}=0$. Therefore, $\exists\,g^{\mu\nu}:M\to\mathbb{R}$ such that $g_{\mu\lambda}g^{\lambda\nu}=\delta_{\mu}^\nu$. In other words, the matrix $[g^{\mu\nu}]$ is the inverse of the matrix $[g_{\mu\nu}]$.    
	\vspace{3 mm}\\
	The metric tensor $g$, apart from other symmetric nondegenerate bilinear forms, is unique in its ability to define lengths (of vectors) and angles (between vectors) on $TM$ within a specific context. Because the basis vectors $\bm{e}_\mu$ on $TM$ are linked to the respective coordinates on $M$ (see Appendix A), $g_{\mu\nu}=g(\bm{e}_\mu,\bm{e}_\nu)$ establishes the geometry on the Manifold itself. 
	\vspace{3 mm}\\
	The $\mu^{\text{th}}$ covariant component of the vector field $\bm{V}$ is defined by $V_\mu\coloneq g(\bm{e}_\mu,\bm{V})=g_{\mu\nu}V^\nu$. With this notational convention, the length of $\bm{V}$ will be defined as such:
	\begin{equation*}
		||\bm{V}||\coloneq\sqrt{g(\bm{V},\bm{V})}=\sqrt{\displaystyle{g_{\mu\nu}V^\mu V^\nu}}=\sqrt{\displaystyle{V_\mu V^\mu}}
	\end{equation*}
	Given the map $\gamma:I\subseteq\mathbb{R}\to M$ with a respective parametrized chart $\alpha$ and tangent field $\dot{\boldsymbol{\gamma}}$, the arc-length along the curve $\gamma(I)$, which describes the Manifold's intrinsic geometry, is defined as such:
	\begin{equation*}
		L(\gamma(I))\coloneq\int_I||\dot{\boldsymbol{\gamma}}(\gamma)||\,dt=\int_I\sqrt{g(\dot{\boldsymbol{\gamma}}(\gamma),\dot{\boldsymbol{\gamma}}(\gamma))}\;dt=\int_I\sqrt{g(\dot\alpha^\mu\bm{e}_\mu(\gamma),\dot\alpha^\nu\bm{e}_\nu(\gamma))}\;dt=\int_I\sqrt{\displaystyle{g_{\mu\nu}(\gamma)\dfrac{d\alpha^\mu}{dt}\dfrac{d\alpha^\nu}{dt}}}\;dt
	\end{equation*}
	These definitions implicitly assume $g$ to be positive definite. That is, vector lengths are always to be non-negative. However, there exists (non-Riemannian) geometries in which this is not the case. In such instances, only the square of the vector lengths and the moduli of the (path) arc-lengths are considered.
	
	\section*{Metric Compatibility - Sketch}
	By definition, the connection $\nabla$ is metric compatible if, for any vector fields $\bm{X}$ and $\bm{Y}$, it obeys the following derivation/Leibniz rule on the metric tensor $g$:
	\begin{equation*}
		\nabla\left(g(\bm{X},\bm{Y})\right)=g(\nabla\bm{X},\bm{Y})+g(\bm{X},\nabla\bm{Y})
	\end{equation*}
	Equivalently, in any coordinate/basis direction $\sigma$, this statement can be reformulated as such:
	\begin{align*}
		\nabla_\sigma(g(\bm{X},\bm{Y}))&=g(\nabla_{\sigma}\bm{X},\bm{Y})+g(\bm{X},\nabla_\sigma\bm{Y})=g\left(\left(\partial_\sigma X^\mu+\Gamma_{\lambda\sigma}^\mu X^\lambda\right)\bm{e}_\mu,Y^\nu\bm{e}_\nu\right)+g\left(X^\mu\bm{e}_\mu,\left(\partial_\sigma Y^\nu+\Gamma_{\lambda\sigma}^\nu Y^\lambda\right)\bm{e}_\nu\right)
		\\[3 mm]
		&=\left(\partial_\sigma X^\mu+\Gamma_{\lambda\sigma}^\mu X^\lambda\right)Y^\nu g(\bm{e}_\mu,\bm{e}_\nu)+X^\mu\left(\partial_\sigma Y^\nu+\Gamma_{\lambda\sigma}^\nu Y^\lambda\right)g(\bm{e}_\mu,\bm{e}_\nu)
		\\[3 mm]
		&=g_{\mu\nu}\left(\partial_\sigma X^\mu Y^\nu+X^\mu\partial_\sigma Y^\nu\right)+X^\lambda Y^\nu\Gamma_{\lambda\sigma}^\mu g_{\mu\nu}+X^\mu Y^\lambda\Gamma_{\lambda\sigma}^\nu g_{\mu\nu}
		\\[3 mm]
		&=g_{\mu\nu}\partial_\sigma\left(X^\mu Y^\nu\right)+X^\mu Y^\nu\left(\Gamma_{\mu\sigma}^{\lambda}g_{\lambda\nu}+\Gamma_{\nu\sigma}^\lambda g_{\mu\lambda}\right)\,\text{---------------------------------------------------}\;(1)
		\\[3 mm]
		\text{(and)}\quad&=\nabla_\sigma\left(g_{\mu\nu}X^\mu Y^\nu\right)=\partial_\sigma\left(g_{\mu\nu}X^\mu Y^\nu\right)=\partial_\sigma g_{\mu\nu}X^\mu Y^\nu+g_{\mu\nu}\partial_\sigma\left(X^\mu Y^\nu\right)\,\text{-----------------------}\;(2)
	\end{align*}
	\begin{align*}
		&\iff\partial_\sigma g_{\mu\nu}X^\mu Y^\nu+g_{\mu\nu}\partial_\sigma\left(X^\mu Y^\nu\right)=g_{\mu\nu}\partial_\sigma\left(X^\mu Y^\nu\right)+X^\mu Y^\nu\left(\Gamma_{\mu\sigma}^{\lambda}g_{\lambda\nu}+\Gamma_{\nu\sigma}^\lambda g_{\mu\lambda}\right)
		\\[3 mm]
		&\iff X^\mu Y^\nu\left(\partial_\sigma g_{\mu\nu}-\Gamma_{\mu\sigma}^\lambda g_{\lambda\nu}-\Gamma_{\nu\sigma}^\lambda g_{\mu\lambda}\right)=X^\mu Y^\nu\left(\nabla_\sigma g\right)_{\mu\nu}=0
		\\[3 mm]
		&\iff\nabla g=0\qquad\text{(i.e. the metric/geometry is invariant under parallel transportation)}
	\end{align*}
	Therefore, the statement of metric compatibility can be compressed into the below tensor equation:
	\vspace{1 mm}
	\begin{Large}
		\begin{equation*}
			\nabla\left(g(\bm{X},\bm{Y})\right)=g(\nabla\bm{X},\bm{Y})+g(\bm{X},\nabla\bm{Y})\iff\nabla g=0
		\end{equation*}
	\end{Large}
	
	\section*{Appendix A - Basis Evaluation}
	Here, the directional derivative of scalar fields will be revisited. Previously, it was (implicitly) stated that for every $f\in C^1(M,\mathbb{R})$, one has $\bm{e}_i[f]=\partial_i f$. However, this is only a choice rooted in a specific convention. 
	\vspace{3 mm}\\
	Let
	$\gamma:I=[0,1]\to M$ be a smooth map with a respective parameterized coordinate chart mapping $\alpha=\varphi\circ\gamma$. The directional derivative along the curve parameterization $\gamma$ of the scalar field $f$ at $p=\gamma(0)$ is defined by:
	\begin{center}
		$\left.D_{\dot\gamma}f\right|_{p}\coloneq\left.\dfrac{d}{dt}f(\gamma(t))\right|_{t=0}=\left.\dfrac{d}{dt}\left(f\left(\varphi^{-1}\right)\circ\alpha(t)\right)\right|_{t=0}=\left.\dfrac{d\alpha^j}{dt}\right|_{t=0}\left.\dfrac{\partial f}{\partial x^j}\right|_p\implies \left.D_{\dot\gamma}\right|_p=\dot\alpha^j(0)\left.\partial_j\right|_p$
	\end{center}
	Given the frame adapters $Q_i^j\in C^{\infty}(M,\mathbb{R})$, for any $\gamma$, $\exists\,\bm{u}=u^j\bm{e}_j\in\Gamma(TM)$ such that $\dot\alpha^j=Q_i^j(\gamma)\,u^i(\gamma)$. Therefore, on $\gamma(I)$, the operator $D_{\dot\gamma}=u^iQ_i^j\partial_j\in\mathrm{span}\{Q_i^j\partial_j\}\subseteq\mathrm{span}\{\partial_i\}\eqqcolon\mathcal{D}(M)$, the space of directional derivative operators $D$ along any curve on $M$. Due to linear independence, $\{\partial_i\}$ forms a basis on $\mathcal{D}(M)$. 
	\vspace{3 mm}\\
	Because $\mathrm{card}\{Q_i^j\partial_j\}=\mathrm{card}\{\partial_i\}$, $\mathrm{span}\{Q_i^j\partial_j\}=\mathcal{D}(M)$ if and only if $\{Q_i^j\partial_j\}$ is likewise linearly independent if and only if the corresponding matrix $Q$ is invertible (i.e. $\mathrm{det}(Q)\neq0$). In other words, for any coordinate chart $\varphi$, the map $\alpha$ uniquely determines $\bm{u}$ on $\gamma(I)$ if and only if $\{Q_i^j\partial_j\}$ forms a basis on $\mathcal{D}(M)$. 
	\vspace{3 mm}\\
	The directional derivative of $f$ in the direction $\bm{u}$ is defined point-wise by $D_{\bm{u}}f\coloneq\bm{u}[f]\coloneq D_{\dot\gamma}f$, which implies $\bm{u}[\cdot]=u^iQ_i^j\partial_j(\cdot)$. As the curve mapping $\gamma$ is arbitrary, it follows $\bm{e}_i[\cdot]=Q_i^j\partial_j(\cdot)$. Setting $\bm{e}_i=Q_i^j\partial_j$ naturally defines the basis elements on $TM$ assuming $\mathrm{det}(Q)\neq0$, thereby establishing $TM=\mathcal{D}(M)$ in that case. 
	\vspace{3 mm}\\
	If $\mathrm{det}(Q)\neq0$, the collection of basis elements $\{\bm{e}_i\}$ is said to be a frame on $TM$. Furthermore, if there exists local coordinate functions $y^i\in C^{\infty}(M,\mathbb{R})$ such that $\bm{e}_i[\cdot]=\frac{\partial}{\partial y^i}(\cdot)$, then $\{\bm{e}_i\}$ is said to be a coordinate frame on $TM$, which constrains $Q$. Given another coordinate frame $\left\{\bbar{\bm{e}}_i\right\}$ with respective coordinates $\bar{x}$ and $\bar{y}$:
	\begin{center}
		$\bm{e}_i[\cdot]=Q_i^j\frac{\partial}{\partial x^j}(\cdot)=\frac{\partial}{\partial y^i}(\cdot)=\frac{\partial x^j}{\partial y^i}\frac{\partial}{\partial x^j}(\cdot)\iff Q_i^j=\frac{\partial x^j}{\partial y^i}=\frac{\partial\bar{y}^l}{\partial y^i}\frac{\partial x^j}{\partial\bar{x}^k}\frac{\partial\bar{x}^k}{\partial\bar{y}^l}=\frac{\partial\bar{y}^l}{\partial y^i}\frac{\partial x^j}{\partial\bar{x}^k}\bbar{Q}_l^k$
	\end{center}
	\vspace{1 mm}
	Without constraining the structure of the basis elements, the commutator, which reflects the failure for the anti-commuted coordinate flows to close, will be applied (with the assumption that $\partial_i\partial_j=\partial_j\partial_i$) as such:
	\begin{align*}
		[\bm{e}_i,\bm{e}_j][\cdot]&=\bm{e}_i[\bm{e}_j[\cdot]]-\bm{e}_j[\bm{e}_i[\cdot]]=Q_i^l\partial_l\left(Q_j^k\partial_k(\cdot)\right)-Q_j^k\partial_k\left(Q_i^l\partial_l(\cdot)\right)
		\\[2 mm]
		&=Q_i^l\partial_lQ_j^k\partial_k(\cdot)+Q_i^lQ_j^k\partial_l\partial_k(\cdot)-Q_j^k\partial_kQ_i^l\partial_l(\cdot)-Q_j^kQ_i^l\partial_k\partial_l(\cdot)
		\\[2 mm]
		&=Q_i^l\partial_lQ_j^k\partial_k(\cdot)+Q_i^lQ_j^k\left(\partial_l\partial_k-\partial_k\partial_l\right)(\cdot)-Q_j^l\partial_lQ_i^k\partial_k(\cdot)=\left(Q_i^l\partial_lQ_j^k-Q_j^l\partial_lQ_i^k\right)\partial_k(\cdot)
	\end{align*}
	Non-trivially, with $[\bm{e}_i,\bm{e}_j]=0$ being equivalent to $Q_i^l\partial_lQ_j^k=Q_j^l\partial_lQ_i^k$, in conjunction with the demand that $\{\bm{e}_i\}$ forms a frame on $TM$, the structure is forced on the basis. In particular, by Frobenius's Theorem:
	\vspace{0.25 mm}
	\begin{large}
		\begin{center}
			$\boxed{\;[\bm{e}_i,\bm{e}_j]=0\;\wedge\;\{\bm{e}_i\}\;\text{is a frame}\;\iff\;\{\bm{e}_i\}\;\text{is a coordinate frame}\;}$
		\end{center}
		\vspace{0.25 mm}
	\end{large}
	Given $\{\bm{e}_i\}$ and $\{\bbar{\bm{e}}_i\}$ are coordinate frames on $TM$, there exists local coordinate functions $y^i,\bar{y}^i\in C^{\infty}(M,\mathbb{R})$ such that $\bm{e}_i[\cdot]=\frac{\partial}{\partial y^i}(\cdot)$ and $\bbar{\bm{e}}_i[\cdot]=\frac{\partial}{\partial\bar{y}^i}(\cdot)$, which implies $\bm{e}_i=\frac{\partial\bar{y}^j}{\partial y^i}\bbar{\bm{e}}_j=Q_i^l\frac{\partial\bar{x}^k}{\partial x^l}(\bbar{Q}^{-1})_k^j\bbar{\bm{e}}_j$ via the chain rule.
	\vspace{2 mm}\\
	Also, the co-coordinate frame $\left\{\bm{e}^j\right\}$ on $T^*M$ can be constructed utilizing (generalized) differential one-forms $df:\bm{v}\in TM\mapsto\bm{v}[f]$. In particular, $\left\{\bm{e}^j\right\}$ is uniquely governed by $\bm{e}^j=(Q^{-1})_k^j\,dx^k$, which implies ($\iff$): 
	\vspace{1 mm}
	\begin{center}
		$\bm{e}^j(\bm{e}_i)=(Q^{-1})_k^j\,dx^k(\bm{e}_i)=(Q^{-1})_k^j\,\bm{e}_i[x^k]=(Q^{-1})_k^jQ_i^l\partial_lx^k=(Q^{-1})_k^jQ_i^l\delta_l^k=(Q^{-1})_k^jQ_i^k=\delta_i^j$
		\vspace{2.25 mm}\\
		----- the complimentary frame change law thus follows -----
		\vspace{2.25 mm}\\
		$\bm{e}^k(\bm{e}_i)=\delta_i^k=\frac{\partial y^k}{\partial\bar{y}^j}\frac{\partial\bar{y}^l}{\partial y^i}\delta_l^j=\frac{\partial y^k}{\partial\bar{y}^j}\frac{\partial\bar{y}^l}{\partial y^i}\bbar{\bm{e}}^j(\bbar{\bm{e}}_l)=\frac{\partial y^k}{\partial\bar{y}^j}\bbar{\bm{e}}^j\left(\frac{\partial\bar{y}^l}{\partial y^i}\bbar{\bm{e}}_l\right)=\frac{\partial y^k}{\partial\bar{y}^j}\bbar{\bm{e}}^j(\bm{e}_i)\iff\bm{e}^k=\frac{\partial y^k}{\partial\bar{y}^j}\bbar{\bm{e}}^j=(Q^{-1})_i^k\frac{\partial x^i}{\partial\bar{x}^l}\bbar{Q}_j^l\bbar{\bm{e}}^j$
	\end{center}    
	From the frame change laws, if $\frac{\partial\bar{y}^i}{\partial y^j}=\frac{\partial\bar{x}^i}{\partial x^j}$, or equivalently, $Q_i^j=\frac{\partial\bar{x}^l}{\partial x^i}\frac{\partial x^j}{\partial\bar{x}^k}\bbar{Q}_l^k$ (i.e. the elements of $Q$ transform as type (1,1) tensor field components), then the contravariant and covariant transformation laws follow:
	\begin{center}
		\large
		-----$\boxed{\;\text{contravariant}\;}$---------$\boxed{\;\bm{e}_i=\tfrac{\partial\bar{x}^j}{\partial x^i}\bbar{\bm{e}}_j\;}\qquad\underline{\text{and}}\qquad\boxed{\;\bm{e}^k=\tfrac{\partial x^k}{\partial\bar{x}^j}\bbar{\bm{e}}^j\;}$---------$\boxed{\;\;\;\;\text{covariant}\;\;\;\;}$-----
	\end{center}
	

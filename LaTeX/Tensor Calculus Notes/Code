	\section*{Covariant Differentiation of Vector Fields}
	Upon inspection, $\mathcal{P}^{\gamma}_{a,a}=\mathrm{id}_{T_{\gamma(a)}M}$, and so in order to ensure that $\mathcal{P}$ is a smooth operation (along any curve), there must exist smooth functions (connection coefficients) $\Gamma_{ij}^k\in C^{\infty}(M,\mathbb{R})$ and $(\Gamma^{\gamma})_{ij}^k\in C^{\infty}(I\times I,\mathbb{R})$, where $(\Gamma^{\gamma})_{ij}^k(t,t)=\Gamma_{ij}^k(\gamma(t))$, such that, via a local expansion (Taylor's Theorem) along the curve at the point $\gamma(a)$, $(\mathcal{P}^{\gamma})_i^k(a,b)=\delta_i^k-(\Gamma^{\gamma})_{ij}^k(a,b)\,\delta x^j_{\gamma}(a,b)+\left.\mathcal{O}\left(\delta x^j_{\gamma}\delta x^k_{\gamma}\right)\right|_{(a,b)}$ for any $a,b\in I$.  
	\vspace{3 mm}\\
	At this point, consider the vector field $\bm{V}\in\Gamma(TM): p\mapsto V^i(p)\,\bm{e}_i(p)$, and construct its restriction to $\gamma$ given by $\bm{V}_{\gamma}=\bm{V}(\gamma)=V^i_{\gamma}\,\bm{e}_i^{\gamma}$ (i.e. $V^i(\gamma)=V^i_{\gamma}$). Given $0,\delta t\in I$, the expression $\mathcal{P}^{\gamma}_{\delta t,0}(\bm{V}_{\gamma}(\delta t))-\bm{V}_\gamma(0)$ quantifies the change in $\bm{V}$ relative to $\gamma(0)$ as it is parallel transported from $\gamma(\delta t)$ back to $\gamma(0)$ along the curve:  
	\vspace{1.5 mm}
	\begin{align*}
		\mathcal{P}_{\delta t,0}^{\gamma}&(\bm{V}_{\gamma}(\delta t))-\bm{V}_\gamma(0)=V^i_{\gamma}(\delta t)\left(\mathcal{P}^{\gamma}\right)_i^k(\delta t,0)\,\bm{e}_k^{\gamma}(0)-V^i_{\gamma}(0)\,\bm{e}_i^{\gamma}(0)
		\\[4 mm]
		&=V_{\gamma}^i(\delta t)\left(\delta_i^k-(\Gamma^{\gamma})_{ij}^k(\delta t,0)\,\delta x^j_{\gamma}(\delta t,0)+\left.\mathcal{O}\left(\delta x^j_{\gamma}\delta x^k_{\gamma}\right)\right|_{(\delta t,0)}\right)\bm{e}_k^{\gamma}(0)-V^k_{\gamma}(0)\,\bm{e}_k^{\gamma}(0)
		\\[4 mm]
		&=\left(V^k_{\gamma}(\delta t)-V^k_{\gamma}(0)+V^i_{\gamma}(\delta t)(\Gamma^{\gamma})_{ij}^k(\delta t,0)\,\delta x^j_{\gamma}(0,\delta t)+\left.\mathcal{O}\left(\delta x^j_{\gamma}\delta x^k_{\gamma}\right)\right|_{(0,\delta t)}\right)\bm{e}_k^{\gamma}(0)
		\\[4 mm]
		&=\left(\left.\partial_jV^k\right|_{\gamma(0)}\delta x^j_{\gamma}(0,\delta t)+V^i_{\gamma}(\delta t)\,(\Gamma^{\gamma})_{ij}^k(\delta t,0)\,\delta x^j_{\gamma}(0,\delta t)+\left.\mathcal{O}\left(\delta x^j_{\gamma}\delta x^k_{\gamma}\right)\right|_{(0,\delta t)}\right)\bm{e}_k^{\gamma}(0)
		\\[4 mm]
		&=\delta x^j_{\gamma}(0,\delta t)\left(\left.\partial_jV^k\right|_{\gamma(0)}+(\Gamma^{\gamma})_{ij}^k(\delta t,0)V^i_{\gamma}(\delta t)+\mathcal{O}\left(\delta x^k_{\gamma}(0,\delta t)\right)\right)\bm{e}_k^{\gamma}(0)
	\end{align*}
	\begin{center}
		Take particular note of the shorthand: $\left.\partial_j\right|_p=\left.\dfrac{\partial}{\partial x^j}\right|_p:f\in C^{1}(M,\mathbb{R})\mapsto\left.\dfrac{\partial\left(f\circ\varphi^{-1}\right)}{\partial x^j}\right|_{\varphi(p)}$
	\end{center}
	\vspace{1 mm}
	Now, let $\bm{u}=u^j\bm{e}_j\in\Gamma(TM)$ such that $\bm{u}(\gamma)=\dot\gamma$, or equivalently, $u^j(\gamma)=\dot\alpha^j$. Observe how $\bm{u}$ links $\varphi$ to the basis on $TM$ (see Appendix A). Also, take note $\mathcal{O}\left(\delta x^k_{\gamma}(0,\delta t)\right)=\mathcal{O}(\delta t)$ via the MVT, thereby supplementing the construction of the covariant derivative of the vector field $\bm{V}$ with respect to $\gamma$ at $p=\gamma(0)$:
	\begin{align*}
		\nabla_{\bm{u}}\bm{V}(p)&\coloneq\nabla_{\dot\gamma}\bm{V}(0)\coloneq\left.\dfrac{d}{dt}\right|_{t=0}\mathcal{P}^\gamma_{t,0}(\bm{V}_\gamma(t))=\lim\limits_{\delta t\to0}\dfrac{\mathcal{P}_{\delta t,0}^{\gamma}(\bm{V}_{\gamma}(\delta t))-\bm{V}_{\gamma}(0)}{\delta t}
		\\[4 mm]
		&=\lim\limits_{\delta t\to0}\dfrac{\delta x^j_{\gamma}(0,\delta t)}{\delta t}\left(\left.\partial_jV^k\right|_{\gamma(0)}+(\Gamma^{\gamma})_{ij}^k(\delta t,0)\,V^i_{\gamma}(\delta t)+\mathcal{O}(\delta t)\right)\bm{e}_k^\gamma(0)
		\\[4 mm]
		&=\lim\limits_{\delta t\to 0}\dfrac{\alpha^j(\delta t)-\alpha^j(0)}{\delta t}\left(\left.\partial_jV^k\right|_{\gamma(0)}+\lim\limits_{\delta t\to0}(\Gamma^{\gamma})_{ij}^k(\delta t,0)\lim\limits_{\delta t\to0}V^i_{\gamma}(\delta t)+\lim\limits_{\delta t\to0}\mathcal{O}(\delta t)\right)\bm{e}_k^\gamma(0)
		\\[4 mm]
		&=\left.\dfrac{d\alpha^j}{dt}\right|_{t=0}\left(\left.\partial_jV^k\right|_{\gamma(0)}+(\Gamma^{\gamma})_{ij}^k(0,0)\,V^i_\gamma(0)\right)\bm{e}_k^\gamma(0)
		\\[4 mm]
		&=u^j(p)\left(\left.\partial_jV^k\right|_p+\Gamma_{ij}^k(p)V^i(p)\right)\bm{e}_k(p)\quad\text{with shorthand}\quad(\nabla_j\bm{V})^k=\partial_jV^k+\Gamma_{ij}^kV^i
	\end{align*}
	The above expression, is evaluated locally at $p$ (i.e. lacks global dependence on $\gamma$), and is, by definition, the covariant derivative of $\bm{V}$ in the direction $\bm{u}$ at the point $p$. As the choices of $p$ and $\bm{u}$ (or $\gamma$) were arbitrary, this operation holds for any such choices, thereby establishing the vector field(s):   
	\vspace{1 mm}
	\begin{center}
		\begin{LARGE}
			$\boxed{\;\nabla_{\bm{u}}\bm{V}=u^j\left(\partial_jV^k+\Gamma_{ij}^kV^i\right)\bm{e}_k\;}\quad\boxed{\;\nabla_j\,\bm{e}_i=\Gamma_{ij}^k\,\bm{e}_k\;}$
		\end{LARGE}
		\vspace{2 mm}\\
		\begin{large}
			The Covariant Derivative on Vector Fields 
		\end{large}
	\end{center} 
	
	\section*{Properties of the Connection}
	At this point, it should be apparent as to what the connection coefficients are. To be specific, observe that $\Gamma^k_{ij}=(\nabla_j\,\bm{e}_i)^k$.
	In other words, $\Gamma^{k}_{ij}$ is the coefficient of the $k^{\text{th}}$ component relative to the frame $\{\bm e_i\}$ of the covariant derivative of the basis vector (field) $\bm{e}_i$ in the $\bm{e}_j$ direction. It thus quantifies how $\bm{e}_i$ deviates from being parallel when transported along the $\bm{e}_j$ direction, as resolved against the $\bm{e}_k$ direction.
	\vspace{3 mm}\\
	Let $\bm{X},\bm{Y},\bm{Z}\in\Gamma(TM)$, and let $f,g\in C^{\infty}(M,\mathbb{R})$. Also, consider the scalars $a,b\in\mathbb{R}$. Conventionally, the directional derivative of $f$ along $\bm{X}=X^i \bm{e}_i$ is given by $D_{\bm{X}}f=\bm{X}[f]=X^i\partial_if$ (see Appendix A). Hence the natural basis $\left\{\partial_i|_p\right\}$ on $T_pM$. In this light, the following properties hold (upon inspection) point-wise:
	\vspace{2 mm}
	\begin{itemize}
		\item $\nabla_{\bm{Z}}\left(a\bm{X}+b\bm{Y}\right)=a\nabla_{\bm{Z}}\bm{X}+b\nabla_{\bm{Z}}\bm{Y}$ -------------------------------------- Linearity in Second Slot ------------------ 
		\item $\nabla_{f\bm{X}+g\bm{Y}}\bm{Z}=f\,\nabla_{\bm{X}}\bm{Z}+g\nabla_{\bm{Y}}\bm{Z}$ ------------------------------------------ Functional Linearity in First Slot ------
		\item $\nabla_{\bm{X}}f\coloneq\bm{X}[f]$\, --------------------------------------------------------------- Scalar Field Compatibility ---------------
		\item $\nabla_{\bm{Y}}\left(f\,\bm{X}\right)=\left(\nabla_{\bm{Y}}f\right)\bm{X}+f\,\nabla_{\bm{Y}}\bm{X}$ --------------------------------------- Leibniz Rule ---------------------------------
	\end{itemize}
	\vspace{3 mm}
	Any operation that contains the above structure (minus scalar field compatibility) is known as a linear (affine) connection, which is denoted by $\nabla$. In this regard, every such $\mathcal{P}$ induces a linear connection.
	
	\section*{Refining Parallel Transport} 
	Here, the notion of parallel transport will be refined using the connection. By definition, $\bm{V}\in\Gamma(TM)$ is said to be parallel along $\gamma(I)$ if for any such $a,b\in I$, $\bm{V}_{\gamma}(a)\parallel\bm{V}_{\gamma}(b)$, or equivalently, $\mathcal{P}_{a,b}^{\gamma}(\bm{V}_{\gamma}(a))=\bm{V}_{\gamma}(b)$.
	\vspace{3 mm}\\
	From the previous context, it follows that if $\bm{V}$ is parallel along $\gamma(I)$, then $\nabla_{\dot\gamma}\bm{V}=0$ by definition. In the appropriate context, the converse will now be developed. In particular, in accordance with the definition of $\nabla_{\dot\gamma}\bm{V}$, for any location along the curve mapping $\gamma$, one can write:
	\vspace{2 mm}
	\begin{center}
		$\nabla_{\dot\gamma}\bm{V}(t)=\left.\frac{d}{d\tau}\right|_{\tau=t}\mathcal{P}^\gamma_{\tau,t}(\bm{V}_\gamma(\tau))=\left.\frac{d}{d\tau}\right|_{\tau=t}\mathcal{P}_{b,t}^\gamma\mathcal{P}^\gamma_{\tau,b}(\bm{V}_\gamma(\tau))=\mathcal{P}^\gamma_{b,t}\left.\frac{d}{d\tau}\right|_{\tau=t}\mathcal{P}^\gamma_{\tau,b}(\bm{V}_\gamma(\tau))=\mathcal{P}^\gamma_{b,t}\frac{d}{dt}\mathcal{P}^\gamma_{t,b}(\bm{V}_\gamma(t))$ 
	\end{center}
	\vspace{2 mm}
	By the FTC, $\int_a^b\frac{d}{dt}\mathcal{P}_{t,b}^\gamma(\bm{V}_\gamma(t))\,dt=\mathcal{P}_{b,b}^\gamma(\bm{V}_\gamma(b))-\mathcal{P}_{a,b}^\gamma(\bm{V}_\gamma(a))=\bm{V}_\gamma(b)-\mathcal{P}_{a,b}^\gamma(\bm{V}_\gamma(a))$. Therefore, in the above equality, upon isolating the term $\frac{d}{dt}\mathcal{P}_{t,b}^\gamma(\bm{V}_\gamma(t))$ via a rearrangement of $\mathcal{P}$, it directly follows that:
	\begin{center}
		\vspace{2 mm}
		\large
		$\boxed{\;\mathcal{P}_{a,b}^{\gamma}\left(\bm{V}_{\gamma}(a)\right)=\bm{V}_{\gamma}(b)-\int_{a}^{b}\mathcal{P}_{t,b}^{\gamma}\left(\nabla_{\dot\gamma}\bm{V}(t)\right)dt\quad\text{where}\quad\mathcal{P}_{t,b}^{\gamma}(\nabla_{\dot\gamma}\bm{V}(t))=\tfrac{d}{dt}\mathcal{P}_{t,b}^{\gamma}(\bm{V}_{\gamma}(t))\;}$  
		\vspace{1.5 mm}\\
		The Fundamental Theorem of Calculus on Connections (FTCC)
	\end{center}
	\vspace{2 mm}
	By inspection, the FTCC implies that if $\nabla_{\dot\gamma}\bm{V}=0$, then $\forall\,a,b\in I$, $\mathcal{P}_{a,b}^{\gamma}(\bm{V}_{\gamma}(a))=\bm{V}_{\gamma}(b)$, or equivalently, $\bm{V}_{\gamma}(a)\parallel\bm{V}_{\gamma}(b)$, which directly implies $\bm{V}$ is parallel along $\gamma(I)$. Therefore, $\bm{V}$ is parallel along $\gamma(I)$ if and only if $\nabla_{\dot\gamma}\bm{V}=0$. Thus, as this holds for any such $\gamma$, $\mathcal{P}\leftrightarrow\nabla$ is a unique correspondence.
	\vspace{3 mm}\\
	At this point, $\mathcal{P}$ can be extracted from $\nabla$. Given that $\bm{V}$ is parallel along $\gamma(I)$ and $\bm{V}_\gamma(0)=\bm{v}_p\in T_pM$, it follows that $\bm{V}_{\gamma}(t)=\mathcal{P}_{0,t}^{\gamma}(\bm{v}_p)$, where $\nabla_{\dot\gamma}\bm{V}=0$. Upon a coordinate expansion, this directly implies that $\dot\alpha^j(\nabla_j\bm{V})^k\,\bm{e}_k^\gamma=0$, implying due to linear independence that $\dot\alpha^j(\nabla_j\bm{V})^k=\dot\alpha^j\partial_jV^k(\gamma)+\dot\alpha^j\,\Gamma_{ij}^k(\gamma)V_{\gamma}^i=0$, which corresponds to the uniquely determined IVP given as such:
	\vspace{2 mm}
	\begin{center}
		\begin{Large}
			$\boxed{\vphantom{\dfrac{0}{0}}\;\bm{V}_{\gamma}(t)=\mathcal{P}_{0,t}^{\gamma}(\bm{v}_p)\quad\text{iff}\quad\dot{V}_{\gamma}^k+\dot\alpha^j\,\Gamma_{ij}^k(\gamma)V_{\gamma}^i=0\quad\text{s.t.}\quad\bm{V}_{\gamma}(0)=\bm{v}_p\;}$  
		\end{Large}
		\vspace{2 mm}\\
		\large
		The Parallel Transport Equation
	\end{center}
	\vspace{2 mm}
	Alternatively, by iterating the FTCC and applying Cauchy's repeated integration formula (on the remainder), the coordinate-free Taylor expansion for the parallel transport operation can be deduced as follows:
	\[
	\mathcal{P}_{a,b}^{\gamma}(\bm{V}_\gamma(a))=\sum\limits_{k=0}^N\dfrac{(-1)^k(b-a)^k}{k!}\nabla^k_{\dot\gamma}\bm{V}(b)+\frac{(-1)^N}{N!}\int_{a}^{b}(t-a)^N\mathcal{P}_{t,b}^{\gamma}\left(\nabla_{\dot\gamma(t)}^{N+1}\bm{V}\right)dt=\bm{V}_\gamma(b)-(b-a)\nabla_{\dot\gamma}\bm{V}(b)+\dots
	\]
	
	\section*{Geodesics}
	By definition, a geodesic is a curve whose tangents are parallel. More concretely, a curve mapping $\gamma:I\to M$ is said to be a geodesic if for any $a,b\in I$, it satisfies $\dot\gamma(a)\parallel\dot\gamma(b)$. Using shorthand, $\nabla_{\dot\gamma}\dot\gamma=0$. Contextually, provided that $\dot\gamma(0)=\bm{v}_p\in T_pM$, it directly follows from the parallel transport equation:
	

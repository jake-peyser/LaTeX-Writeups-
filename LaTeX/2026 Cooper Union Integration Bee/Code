\section*{Integral \#6 (Very Hard)}
\[
I=\int_0^\infty \frac{x}{e^x-1}dx\qquad\text{Hint: Geometric Series!}
\]
Solution Methodology:
\begin{itemize}
    \item Algebraic manipulation: $\frac{1}{e^x-1}=\frac{e^{-x}}{1-e^{-x}}$ 
    \item Expand via a geometric series: $\frac{1}{1-e^{-x}}=\sum_{n=0}^\infty e^{-nx}$
    \item Simplify Integrand
    \item Swap summation and integration operators: $\int_0^\infty\sum_{n=0}^\infty=\sum_{n=0}^\infty\int_0^\infty$
    \item Sub: $t=(n+1)x$
    \item Separate the integral: $\sum_{n=0}^\infty\int_0^\infty(\frac{t}{n+1})e^{-t}(\frac{1}{n+1})dt=\sum_{n=0}^\infty\frac{1}{(n+1)^2}\int_0^\infty te^{-t}dt$
    \item Identify the Basel Problem and the Gamma Function (or use IBP)
\end{itemize}
\[
\boxed{\;I=\frac{\pi^2}{6}\;}
\]


\section*{Integral \#15 (Hard)}
\[
I=\int_1^\infty\frac{dx}{x^2\sqrt{x^2+x-1}}
\]
Solution Methodology:
\begin{itemize}
    \item Sub: $u=1/x$
    \item Simplify
    \item Complete the square: $1+u-u^2=\frac{5}{4}-(u-1/2)^2$
    \item Sub: $v=u-1/2$
    \item Split integral and abuse odd symmetry
    \item Sub: $t=\frac{2}{\sqrt5}v$
\end{itemize}
\[
\boxed{\;\sin^{-1}\left(\frac{1}{\sqrt 5}\right)\;}
\]

\section*{Integral \#16 (Super Hard)}
\[
I=\int_0^\infty\frac{e^{-t}-e^{-2t}}{t}\cos(t)\,dt\qquad\text{Hint: Laplace Transform}
\]
Solution Methodology:
\begin{itemize}
    \item Define the auxiliary function:
\[
\quad F(s)=\int_0^\infty e^{-st}\,\frac{1-e^{-t}}{t}\cos(t)\,dt,\quad F(1)=I
\]
\item Compute the derivative:
\[
F'(s)=\int_0^\infty\frac{\partial}{\partial s}\left[ e^{-st}\,\frac{1-e^{-t}}{t}\cos(t)\right]dt=-\int_0^\infty e^{-st}(1-e^{-t})\cos(t)\,dt
\]
\item Split the integral:
\[
F'(s)=\int_0^\infty e^{-(s+1)t}\cos(t)\,dt-\int_0^\infty e^{-st}\cos(t)\,dt=\mathcal{L}_t\left\{\cos(t)\right\}(s+1)-\mathcal{L}_t\left\{\cos(t)\right\}(s)
\]
\item Compute the Laplace Transforms:
\[
F'(s)=\frac{s+1}{(s+1)^2+1}-\frac{s}{s^2+1}
\]
\item Apply the FTC:
\[
F(1)=\lim_{s\to\infty}F(s)-\int^\infty_1F'(s)\,ds
\]
\item Compute the limit:
\[
\lim_{s\to\infty}F(s)=\int_0^\infty\lim_{s\to\infty}e^{-st}\,\frac{1-e^{-t}}{t}\cos(t)\,dt=0
\]
\item Compute the integral:
\begin{align*}
\int_1^{\infty}F'(s)\,ds&=\int_1^{\infty}\left[\frac{s+1}{(s+1)^2+1}-\frac{s}{s^2+1}\right]ds
\\[5 mm]
&=\left.\left(\frac{1}{2}\ln\left((s+1)^2+1\right)-\frac{1}{2}\ln\left(s^2+1\right)\right)\right|_1^\infty=-\frac{1}{2}\ln\left(\frac{5}{2}\right)
\end{align*}
\item Synthesize
\end{itemize}
\[
\boxed{\;I=\frac{1}{2}\ln\left(\frac{5}{2}\right)\;}
\]


\[
\boxed{\;I=\frac{5}{9}-\frac{2}{3}\ln2\;}
\]

\section*{Integral \#2 (Hard)}
\[
I=\int_0^1 e^{-t^2}f(t)\,dt\quad\text{with}\quad f(t)=\sum_{n=0}^{\infty}e^{-2n(t+n/2)},\quad t\in\mathbb{R}^+
\]
Solution Methodology:
\begin{itemize}
    \item Complete the square: $-2n(t+n/2)=t^2-(t+n)^2$
    \item Simplify Integrand
    \item Swap summation \& integration operators: $\int_0^1\sum_{n=0}^\infty=\sum_{n=0}^\infty\int_0^1$
    \item Sub: $x=t+n$
    \item Sum the integrals: $\sum_{n=0}^\infty\int_n^{n+1}=\int_0^\infty$
    \item Abuse even symmetry: $\int_0^\infty=\tfrac{1}{2}\int_{-\infty}^\infty$
    \item Identify the Gaussian Integral
    \[
    \boxed{\;I=\frac{\sqrt\pi}{2}\;}
    \]
\end{itemize}

